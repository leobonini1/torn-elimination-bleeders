{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "torn-elimination-bleeder-dashboard",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elimination-db",
